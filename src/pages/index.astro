---
import Layout from '../layouts/Layout.astro';
import Header from '../components/organisms/Header.astro';
import Hero from '../components/organisms/Hero.astro';
import ProjectsSection from '../components/organisms/ProjectsSection.astro';
import TechnologiesSection from '../components/organisms/TechnologiesSection.astro';
import ContactSection from '../components/organisms/ContactSection.astro';
import Footer from '../components/organisms/Footer.astro';
---

<Layout title="Andres portfolio.">
	<Header/>
	<main>
		<Hero/>
		<ProjectsSection/>
    <TechnologiesSection/>
    <ContactSection/>
    <Footer/>
	</main>
</Layout>

<style>
	main {
		margin-top:100px;
		width: 100%;
		font-size: 20px;
	}
</style>
