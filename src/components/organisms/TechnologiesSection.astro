---
import SectionTitle from "../atoms/SectionTitle.astro";

import HTML from "../atoms/icons/HTML.astro";
import CSS from "../atoms/icons/CSS.astro";
import React from "../atoms/icons/React.astro";
import Next from "../atoms/icons/Next.astro";
import Node from "../atoms/icons/Node.astro";
import Sass from "../atoms/icons/Sass.astro";
import JS from "../atoms/icons/JS.astro";
import Express from "../atoms/icons/Express.astro";
import Mongo from "../atoms/icons/Mongo.astro";
import Threejs from "../atoms/icons/Threejs.astro";
import Docker from "../atoms/icons/Docker.astro";
import Python from "../atoms/icons/Python.astro";
import Java from "../atoms/icons/Java.astro";
import Spring from "../atoms/icons/Spring.astro";
import Tailwind from "../atoms/icons/Tailwind.astro";
import Angular from "../atoms/icons/Angular.astro";
import Postgres from "../atoms/icons/Postgres.astro";
---

<section id="technologies">
  <SectionTitle>Technologies</SectionTitle>
  <div class="techList">
    <HTML size="3em"/>
    <CSS size="3em"/>
    <Tailwind size="3em"/>
    <Sass size="3em"/>
    <JS size="3em"/>
    <Angular size="3em"/>
    <React size="3em"/>
    <Next size="3em"/>
    <Threejs size="3em"/>
    <Node size="3em"/>
    <Express size="3em"/>
    <Python size="3em"/>
    <Java size="3em"/>
    <Spring size="3em"/>
    <Postgres size="3em"/>
    <Mongo size="3em"/>
    <Docker size="3em"/>

  </div>
</section>

<style>
#technologies {
  background-color: var(--accent-gray);
  margin-top: 2em;
  padding: 1em 0 5em 0;
  text-align: center;
  color: white;
}
.techList{
  width: 80%;
  margin: 0 auto;
  display:grid;
  grid-template-columns: repeat(auto-fill, minmax(100px, 2fr));
  grid-gap: 50px;
  justify-content: center;
  align-items: center;
}

.techList > * {
  transition: transform 0.3s ease-in-out; /* Smooth transition */
  margin: 0 auto;
}

.techList > *:hover {
  transform: scale(1.5); /* Scale the element 1.5 times on hover */
}

@media (max-width: 768px) {
  .techList {
    width: 100%;
  }
}
</style>
